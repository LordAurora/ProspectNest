# Used by docker-compose for the bundled Postgres; keep it in sync with DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://prospectnest:CHANGE_ME@localhost:5432/prospectnest
APP_URL=http://localhost:3000
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
# true: answers reserved .example domains from local synthetic fixtures and shows the demo banner.
DEMO_MODE=false
AI_MODE=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPREADSHEET_ID=
# none | google_places. Google Places stores only place IDs; see README for the terms.
DISCOVERY_PROVIDER=none
DISCOVERY_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=100
WORKER_CONCURRENCY=2
